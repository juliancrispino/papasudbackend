# Copiar a .env (ignorado por Git) y completar. Spring Boot lo carga via
# spring.config.import; una variable de entorno real siempre le gana.

# --- Groq / IA ---
# Sin esta clave todos los endpoints /api/ai responden con engine="heuristic".
# Se obtiene en https://console.groq.com/keys
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/papasud
DB_USER=papasud
DB_PASSWORD=papasud

# --- Auth ---
# En desarrollo alcanza con dev-password (solo se acepta con secure-cookies=false).
PAPASTOCK_AUTH_USERNAME=operador
PAPASTOCK_AUTH_DEV_PASSWORD=
PAPASTOCK_SESSION_SECRET=
